{
  "name": "secure-file-transfer-server",
  "version": "4.0.0",
  "private": true,
  "description": "Private WSS file transfer with mTLS, reusable parallel connections, account bandwidth and durable resume",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "certs:dev": "node scripts/certs-dev.js",
    "health": "node scripts/health.js",
    "user:create": "node scripts/user-create.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:csharp": "node scripts/check-csharp.js",
    "test:cli": "python test/cli-check.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.23.0"
  }
}
