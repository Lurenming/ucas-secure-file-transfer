<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the exact connection/validation sources used by WinForms, without a GUI dependency. -->
    <Compile Include="../SecureFileTransfer.Client/Networking/*.cs" Link="Networking/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
